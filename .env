# Copy to .env.local and fill in real values. .env.local is gitignored.

# Base URL of the backend REST API (server-side only — used in Server
# Components / Route Handlers via src/lib/api/client.ts). No trailing slash.
# Default below matches cps-api's local dev default (see
# D:\project-cps\New\cps-api\API_ENDPOINTS.md § 1) — point elsewhere for
# staging/prod.
API_BASE_URL=http://localhost:3001/api/v1

# Optional: static bearer token / API key while auth isn't wired up yet.
# Leave empty once real auth (session/cookie or login-issued token) is in place.
API_AUTH_TOKEN=
